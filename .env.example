# It's a Wonderful App settings. On the host these live in /etc/conf.d/wonderful (written by the installer, which
# only adds missing keys, and exported by the OpenRC script). For local development the app also reads a .env next
# to app.py (copy this file); variables already in the environment win.

# Port gunicorn / the dev server listens on (each app on the host needs its own; Matinee uses 8771)
PORT=8772
# Where wonderful.db, posters/ and art/ live (default: ./data next to app.py)
DATA_DIR=/var/lib/wonderful
# Time zone for local dates: Advent themes, "Not watched this year", finished_on. Never UTC on the host
TZ=America/Los_Angeles

# Cloudflare Access team domain, e.g. yourteam.cloudflareaccess.com
CF_TEAM_DOMAIN=
# Application Audience (AUD) tag of the Access app in front of this app's hostname (wonderful.example.com)
CF_AUD=
# Comma-separated Access emails allowed in; empty = anyone the Access policy lets through
ADMIN_EMAILS=
# 1 = direct requests on the LAN (by IP address, localhost or a LAN_HOSTS name, not via the tunnel) need no sign-in
LAN_EDIT=1
# Host names LAN requests may use besides IP addresses and localhost, e.g. wonderful.lan (comma-separated, no port)
LAN_HOSTS=
# Optional key for scripts (Authorization: Bearer <key> or X-API-Key: <key>); empty = no key access
WONDERFUL_API_KEY=
# Shared secret Home Assistant sends as the X-Hook-Secret header on POST /hooks/tv. The installer generates one;
# empty = the hook answers 403 to everything
HA_HOOK_SECRET=
# Home Assistant webhook for the Family Room movie log, the same URL Matinee uses, e.g.
# http://ha.example.com:8123/api/webhook/<id>. A SECRET: the id in the URL is the only credential. Empty = off
HA_WEBHOOK_URL=
# Home Assistant webhook that starts something on the Family Room TV (Play on TV), e.g.
# http://ha.example.com:8123/api/webhook/<id>. A SECRET: the id in the URL is the only credential. Empty = off
HA_PLAY_WEBHOOK_URL=

# TMDB v3 API Read Access Token (themoviedb.org -> Settings -> API). Adding movies is off until it is set
TMDB_READ_TOKEN=
# Matinee's address (ownership, household rating, watches), e.g. http://192.168.1.100:8771 or http://127.0.0.1:8771
MATINEE_URL=http://127.0.0.1:8771
# Matinee's MATINEE_API_KEY (its write key), sent as Authorization: Bearer; empty = no Matinee sync
MATINEE_API_KEY=

# Anthropic API key for smart search (descriptions like "a musical"); empty = smart search is off
ANTHROPIC_API_KEY=
# Model smart search uses
AI_MODEL=claude-haiku-5-5
# Smart searches per day across the family; past it search falls back to the list filter
AI_DAILY_CAP=200
# Seconds to wait for the model before search falls back to the list filter
AI_TIMEOUT=20
